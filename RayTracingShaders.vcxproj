  <PropertyGroup>
    <VulkanSdkMinVersion>1.4.363</VulkanSdkMinVersion>
    <VulkanSdkDownloadUrl>https://vulkan.lunarg.com/sdk/home</VulkanSdkDownloadUrl>
    <DxcPath>$(VULKAN_SDK)\Bin\dxc.exe</DxcPath>
    <ShaderOutDir>$(OutDir)shaders\</ShaderOutDir>
    <ShaderIncludes>$(MSBuildProjectDirectory)\source\SharedTypes.h;$([System.String]::Join(';', $([System.IO.Directory]::GetFiles('$(MSBuildProjectDirectory)\source\shaders', '*.hlsli'))))</ShaderIncludes>
    <!-- Embeds the HLSL source in the SPIR-V (NonSemantic.Shader.DebugInfo.100) so Nsight and RenderDoc can show it. -->
    <DxcDebugFlags Condition="'$(Configuration)' == 'Debug'">-Zi -Od -fspv-debug=vulkan-with-source -fspv-extension=SPV_KHR_non_semantic_info</DxcDebugFlags>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <CustomBuild>
      <Message>Compiling %(Identity) to %(Filename).spv</Message>
      <Command>"$(DxcPath)" -T lib_6_3 -spirv -fspv-target-env=vulkan1.2 -fspv-extension=SPV_KHR_ray_tracing -fvk-use-scalar-layout -auto-binding-space 0 -HV 2021 $(DxcDebugFlags) -I "$(MSBuildProjectDirectory)\source\shaders" -I "$(MSBuildProjectDirectory)\source" -Fo "$(ShaderOutDir)%(Filename).spv" "%(FullPath)"</Command>
      <Outputs>$(ShaderOutDir)%(Filename).spv</Outputs>
      <AdditionalInputs>$(ShaderIncludes)</AdditionalInputs>
      <BuildInParallel>true</BuildInParallel>
    </CustomBuild>
  </ItemDefinitionGroup>
  <Target Name="CheckVulkanSdk" BeforeTargets="CustomBuild;ClCompile">
    <Error Condition="'$(VULKAN_SDK)' == ''" Text="Vulkan SDK not found: the VULKAN_SDK environment variable is not set. This project needs the SDK's Vulkan headers and its dxc shader compiler. Download the Windows installer of Vulkan SDK $(VulkanSdkMinVersion) or newer from $(VulkanSdkDownloadUrl), run it, then restart Visual Studio so it sees VULKAN_SDK." />
    <Error Condition="'$(VULKAN_SDK)' != '' And !Exists('$(VULKAN_SDK)\Include\vulkan\vulkan.h')" Text="The Vulkan SDK in $(VULKAN_SDK) has no Vulkan headers ($(VULKAN_SDK)\Include\vulkan\vulkan.h is missing). VULKAN_SDK may point to a removed or incomplete SDK. Install Vulkan SDK $(VulkanSdkMinVersion) or newer from $(VulkanSdkDownloadUrl), then restart Visual Studio." />
    <Error Condition="'$(VULKAN_SDK)' != '' And !Exists('$(DxcPath)')" Text="The Vulkan SDK in $(VULKAN_SDK) has no dxc shader compiler ($(DxcPath) is missing). VULKAN_SDK may point to a removed or incomplete SDK. Install Vulkan SDK $(VulkanSdkMinVersion) or newer from $(VulkanSdkDownloadUrl), then restart Visual Studio." />
    <MakeDir Directories="$(ShaderOutDir)" />
  </Target>
